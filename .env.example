# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://root:password@localhost:5432/copytrade?schema=public"

# Redis Configuration (BullMQ Queue)
REDIS_URL="redis://localhost:6379"

# Telegram Bot Configuration
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Security Configuration
# MUST be EXACTLY 32 characters long. Used for AES-256-CBC encryption of wallets.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# Solana RPC Configuration
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Optional: Helius API for fetching token portfolios accurately
HELIUS_API_KEY="your_helius_api_key_here"
