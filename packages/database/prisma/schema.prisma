generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  telegramId String   @unique
  username  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets       Wallet[]
  settings      UserSettings?
  blockedTokens BlockedToken[]
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  defaultSlippage Float @default(1.0)
  priorityFee     Float @default(0.001)
  dryRunEquitySol Float @default(1.0)  // Virtual equity in SOL for dry-run mode
  stopLossPercent Float @default(20.0) // Auto sell when loss exceeds X% (0 = disabled)
  
  updatedAt DateTime @updatedAt
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  
  publicKey      String   @unique
  encryptedSecret String  // AES-256 encrypted
  iv             String   // Initialization vector for AES
  
  label          String?
  isDefault      Boolean  @default(false)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  copyTargets     CopyTarget[]
  dryRunPositions DryRunPosition[]
  livePositions   LivePosition[]
}

model CopyTarget {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id])
  
  targetAddress  String
  label          String?
  
  status         CopyStatus   @default(ACTIVE)
  mode           CopyMode     @default(COPY)
  strategy       CopyStrategy @default(FIXED)
  fixedAmount    Float?   // Amount in SOL if FIXED
  ratio          Float?   // Ratio if RATIO
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([walletId, targetAddress])
}

model DryRunPosition {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id])
  targetAddress  String
  tokenMint      String
  tokenSymbol    String   @default("")
  
  virtualSolSpent Float   // SOL "spent" to buy this position
  tokenAmount     Float   // Virtual token quantity held
  buyPriceSol     Float   // Average entry price per token in SOL

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([walletId, targetAddress, tokenMint])
}

model LivePosition {
  id             String   @id @default(uuid())
  walletId       String
  wallet         Wallet   @relation(fields: [walletId], references: [id])
  targetAddress  String
  tokenMint      String
  tokenSymbol    String   @default("")
  
  solSpent       Float    // SOL spent to buy this position
  tokenAmount    Float    // Token quantity bought
  buyPriceSol    Float    // Entry price per token in SOL

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([walletId, targetAddress, tokenMint])
}

enum CopyStatus {
  ACTIVE
  PAUSED
}

enum CopyMode {
  COPY
  MONITOR
  DRY_RUN
}

enum CopyStrategy {
  FIXED
  RATIO
}

model BlockedToken {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  
  tokenAddress String
  label        String?
  
  createdAt    DateTime @default(now())

  @@unique([userId, tokenAddress])
}
